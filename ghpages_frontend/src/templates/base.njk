<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page.title }} | {{ site.name }}</title>
  <meta name="description" content="{{ page.description if page.description else site.description }}">
  <meta property="og:title" content="{{ page.title }} | {{ site.name }}">
  <meta property="og:description" content="{{ page.description if page.description else site.description }}">
  <meta property="og:type" content="website">
  <meta name="color-scheme" content="light dark">
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="style.css">
  {% block head %}{% endblock %}
</head>
<body>
  <a class="skip-link" href="#main">本文へ移動</a>

  <header class="site-header" data-header>
    <div class="wrap header-inner">
      <a class="brand" href="index.html">
        <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <rect x="2" y="2" width="20" height="20" rx="6" fill="currentColor"></rect>
          <path d="M7 8.5h10M7 12h6.5M7 15.5h8" stroke="var(--color-brand-ink)" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
        <span>{{ site.name }}</span>
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
        <span class="sr-only">メニューを開く</span>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>

      <nav id="site-nav" class="site-nav" aria-label="主要メニュー">
        <a href="index.html"{% if page.output == 'index.html' %} aria-current="page"{% endif %}>概要</a>
        {% for guide in site.guides %}
        <a href="{{ guide.output }}"{% if guide.output == page.output %} aria-current="page"{% endif %}>{{ guide.nav }}</a>
        {% endfor %}
        <a class="site-nav-external" href="{{ site.repoUrl }}" rel="noopener">
          GitHub
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
            <path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </nav>
    </div>
  </header>

  <main id="main">
    {% block content %}{% endblock %}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        <p class="footer-name">{{ site.name }}</p>
        <p class="footer-desc">{{ site.description }}</p>
      </div>
      <nav class="footer-nav" aria-label="フッターメニュー">
        <a href="index.html">概要・ダウンロード</a>
        {% for guide in site.guides %}
        <a href="{{ guide.output }}">{{ guide.title }}</a>
        {% endfor %}
        <a href="{{ site.releasesUrl }}" rel="noopener">GitHub Releases</a>
        <a href="{{ site.repoUrl }}" rel="noopener">リポジトリ</a>
      </nav>
      <div class="footer-copy">
        <p>Copyright (C) 2003-2026 Edgewall Software.</p>
        <p>Copyright (c) 2006-2026 update it, Inc.</p>
        <p>All rights reserved.</p>
      </div>
    </div>
  </footer>

  <script src="site.js" defer></script>
</body>
</html>

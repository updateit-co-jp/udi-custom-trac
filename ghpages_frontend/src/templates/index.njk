{% extends "base.njk" %}

{% block content %}
{% set rel = site.release %}
{% set tagUrl = site.releasesUrl + '/tag/' + rel.tag %}

<section class="masthead">
  <div class="wrap masthead-grid">
    <div>
      <p class="top-label">Trac フォーク版</p>
      <h1>{{ site.name }}</h1>
      <p class="masthead-lead">
        本家 Trac 1.7.1 を基にした、update it のフォーク版です。
        チケット管理、Wiki、Git / Subversion のリポジトリ連携を提供します。
      </p>
      <ul class="facts-inline">
        <li>版 {{ rel.version }}</li>
        <li>Python 3.13 以上</li>
        <li>Modified BSD License</li>
      </ul>
    </div>

    <aside class="download-panel" aria-labelledby="latest-title">
      <h2 id="latest-title">最新版</h2>
      <dl class="kv">
        <dt>タグ</dt><dd><code>{{ rel.tag }}</code></dd>
        <dt>公開日</dt><dd>{{ rel.date }}</dd>
        <dt>種別</dt><dd>{{ rel.kind }}</dd>
        <dt>正式版</dt><dd>まだ公開していません</dd>
      </dl>
      <div class="panel-actions">
        <a class="btn btn-primary" href="{{ tagUrl }}" rel="noopener">wheel をダウンロード</a>
        <a class="btn btn-ghost" href="install.html">インストール手順</a>
      </div>
    </aside>
  </div>
</section>

<section class="top-section" id="news">
  <div class="wrap">
    <h2>ニュース</h2>
    <ul class="news-list">
      <li>
        <time datetime="{{ rel.date }}">{{ rel.date }}</time>
        <div>
          <a href="{{ tagUrl }}" rel="noopener"><strong>{{ rel.tag }}</strong> を公開</a>
          <p>同日に反映した主な変更です。</p>
          <ul class="plain-list">
            <li>フォームの URL エンコードとマルチパート送信に本文サイズの上限を設定</li>
            <li>マルチパート解析の異常系を修正し、途中で失敗したアップロードの後始末を明示化</li>
            <li>systemd による日々の運用手順を追加</li>
            <li>HTTPS 公開の手順と、本家 Trac 1.6.x からの移行手順を追加</li>
          </ul>
        </div>
      </li>
    </ul>
  </div>
</section>

<section class="top-section section-muted" id="download">
  <div class="wrap">
    <h2>ダウンロード</h2>
    <table class="dl-table">
      <thead>
        <tr><th scope="col">種類</th><th scope="col">版</th><th scope="col">入手先</th></tr>
      </thead>
      <tbody>
        <tr>
          <td>wheel（開発版）</td>
          <td><code>{{ rel.tag }}</code></td>
          <td><a href="{{ tagUrl }}" rel="noopener">GitHub Releases</a></td>
        </tr>
        <tr>
          <td>wheel（正式版）</td>
          <td>—</td>
          <td>まだ公開していません</td>
        </tr>
        <tr>
          <td>ソースコード</td>
          <td>main ブランチ</td>
          <td><a href="{{ site.repoUrl }}" rel="noopener">GitHub リポジトリ</a></td>
        </tr>
      </tbody>
    </table>
    <p class="note-text">動作には Python 3.13 以上が必要です。導入には uv を使う手順を案内しています。</p>
  </div>
</section>

<section class="top-section" id="docs">
  <div class="wrap">
    <h2>ドキュメント</h2>
    <ul class="guide-list">
      {% for guide in site.guides %}
      <li>
        <a class="guide-row" href="{{ guide.output }}">
          <span class="guide-row-main">
            <span class="guide-row-title">{{ guide.title }}</span>
            <span class="guide-row-summary">{{ guide.summary }}</span>
          </span>
          <span class="card-arrow" aria-hidden="true">›</span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="top-section section-muted" id="about">
  <div class="wrap">
    <h2>Trac でできること</h2>
    <p class="section-intro">Trac は、Web で動く課題管理とプロジェクト管理のツールです。</p>
    <dl class="feature-list">
      <div>
        <dt>チケット管理</dt>
        <dd>課題・バグ・作業を登録し、担当、状態、優先度で追跡します。</dd>
      </div>
      <div>
        <dt>Wiki</dt>
        <dd>設計メモや手順を残し、チケットや変更履歴からリンクします。</dd>
      </div>
      <div>
        <dt>Git / Subversion 連携</dt>
        <dd>リポジトリの履歴をブラウズし、コミットからチケットを参照します。</dd>
      </div>
      <div>
        <dt>レポート</dt>
        <dd>条件を指定した一覧や集計で、進捗を確認します。</dd>
      </div>
    </dl>
  </div>
</section>

<section class="top-section" id="license">
  <div class="wrap">
    <h2>ライセンス</h2>
    <p>
      Trac は Modified BSD License で配布されています。全文は
      <a href="https://github.com/updateit-co-jp/udi-custom-trac/blob/main/COPYING" rel="noopener">COPYING</a>
      を参照してください。
    </p>
    <div class="copyright-block">
      <p>Copyright (C) 2003-2026 Edgewall Software.</p>
      <p>Copyright (c) 2006-2026 update it, Inc.</p>
      <p>All rights reserved.</p>
    </div>
  </div>
</section>

<section class="top-section section-muted" id="links">
  <div class="wrap">
    <h2>関連リンク</h2>
    <ul class="link-list">
      <li><a href="https://trac.edgewall.org/" rel="noopener">本家 Trac（trac.edgewall.org）</a></li>
      <li><a href="https://trac.edgewall.org/wiki/MailingList" rel="noopener">本家 Trac のメーリングリスト</a></li>
      <li><a href="{{ site.repoUrl }}" rel="noopener">GitHub リポジトリ</a></li>
      <li><a href="{{ site.releasesUrl }}" rel="noopener">リリース一覧</a></li>
    </ul>
  </div>
</section>
{% endblock %}
